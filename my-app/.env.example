# Resend: https://resend.com/api-keys
RESEND_API_KEY=
# Where form submissions are delivered. Comma-separate multiple addresses.
FORMS_TO_EMAIL=
# Must be on a domain verified in Resend, e.g. Landmark District <forms@landmarkdistrict.com>
FORMS_FROM_EMAIL=
# Browser key for the location map. Restrict it to landmarkdistrict.com in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
